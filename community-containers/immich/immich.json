{
    "aio_services_v1": [
        {
            "container_name": "nextcloud-aio-immich-server",
            "display_name": "Immich",
            "documentation": "https://github.com/nextcloud/all-in-one/tree/main/community-containers/immich",
            "image": "ghcr.io/immich-app/immich-server",
            "image_tag": "v3.2.4",
            "internal_port": "2283",
            "restart": "unless-stopped",
            "depends_on": [
                "nextcloud-aio-immich-database",
                "nextcloud-aio-immich-valkey",
                "nextcloud-aio-immich-machine-learning"
            ],
            "ports": [
                {
                    "ip_binding": "%APACHE_IP_BINDING%",
                    "port_number": "2283",
                    "protocol": "tcp"
                }
            ],
            "environment": [
                "TZ=%TIMEZONE%",
                "DB_HOSTNAME=nextcloud-aio-immich-database",
                "DB_PORT=5432",
                "DB_USERNAME=postgres",
                "DB_PASSWORD=%IMMICH_DB_PASSWORD%",
                "DB_DATABASE_NAME=immich",
                "REDIS_HOSTNAME=nextcloud-aio-immich-valkey",
                "REDIS_PORT=6379"
            ],
            "secrets": [
                "IMMICH_DB_PASSWORD"
            ],
            "volumes": [
                {
                    "source": "nextcloud_aio_immich_data",
                    "destination": "/data",
                    "writeable": true
                }
            ],
            "backup_volumes": [
                "nextcloud_aio_immich_data"
            ]
        },
        {
            "container_name": "nextcloud-aio-immich-machine-learning",
            "display_name": "Immich Machine Learning",
            "documentation": "https://github.com/nextcloud/all-in-one/tree/main/community-containers/immich",
            "image": "ghcr.io/immich-app/immich-machine-learning",
            "image_tag": "v3.2.4",
            "internal_port": "3003",
            "restart": "unless-stopped",
            "environment": [
                "TZ=%TIMEZONE%"
            ],
            "volumes": [
                {
                    "source": "nextcloud_aio_immich_model_cache",
                    "destination": "/cache",
                    "writeable": true
                }
            ]
        },
        {
            "container_name": "nextcloud-aio-immich-valkey",
            "display_name": "Immich Valkey",
            "documentation": "https://github.com/nextcloud/all-in-one/tree/main/community-containers/immich",
            "image": "valkey/valkey",
            "image_tag": "9",
            "internal_port": "6379",
            "restart": "unless-stopped"
        },
        {
            "container_name": "nextcloud-aio-immich-database",
            "display_name": "Immich Database (PostgreSQL)",
            "documentation": "https://github.com/nextcloud/all-in-one/tree/main/community-containers/immich",
            "image": "ghcr.io/immich-app/postgres",
            "image_tag": "14-vectorchord0.4.3-pgvectors0.2.0",
            "internal_port": "5432",
            "restart": "unless-stopped",
            "shm_size": 134217728,
            "environment": [
                "POSTGRES_PASSWORD=%IMMICH_DB_PASSWORD%",
                "POSTGRES_USER=postgres",
                "POSTGRES_DB=immich",
                "POSTGRES_INITDB_ARGS=--data-checksums"
            ],
            "secrets": [
                "IMMICH_DB_PASSWORD"
            ],
            "volumes": [
                {
                    "source": "nextcloud_aio_immich_database",
                    "destination": "/var/lib/postgresql/data",
                    "writeable": true
                }
            ],
            "backup_volumes": [
                "nextcloud_aio_immich_database"
            ]
        }
    ]
}
